# Copie para .env se quiser mudar o padrão (o arquivo .env não vai para o Git).
# Nenhuma variável é obrigatória: sem .env o projeto usa configs/config.yaml.

# Configuração usada pelos alvos do Makefile
CONFIG=configs/config.yaml

# Aponta o rastreio para outro servidor MLflow (ex.: o da empresa).
# Quando definida, tem prioridade sobre mlops.tracking_uri do YAML.
# MLFLOW_TRACKING_URI=http://localhost:5000
